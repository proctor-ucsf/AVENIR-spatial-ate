<span id="cb18-25"><a href="#cb18-25" aria-hidden="true" tabindex="-1"></a>ate_diff_est <span class="ot">&lt;-</span> <span class="fu">mean</span>(ate_diff_boot)</span>
<span id="cb18-26"><a href="#cb18-26" aria-hidden="true" tabindex="-1"></a>ate_diff_ci  <span class="ot">&lt;-</span> <span class="fu">quantile</span>(ate_diff_boot, <span class="fu">c</span>(<span class="fl">0.025</span>, <span class="fl">0.975</span>))</span>
