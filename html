<span id="cb18-19"><a href="#cb18-19" aria-hidden="true" tabindex="-1"></a>  mordor_ate     <span class="ot">&lt;-</span> tbl<span class="sc">$</span>ATE[tbl<span class="sc">$</span>state_type <span class="sc">==</span> <span class="st">"MORDOR"</span>]</span>
