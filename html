<span id="cb16-9"><a href="#cb16-9" aria-hidden="true" tabindex="-1"></a>  <span class="fu">stopifnot</span>(<span class="fu">length</span>(mordor_rate) <span class="sc">==</span> <span class="dv">1</span>, <span class="fu">length</span>(non_mordor_rate) <span class="sc">==</span> <span class="dv">1</span>)</span>
<span id="cb16-10"><a href="#cb16-10" aria-hidden="true" tabindex="-1"></a>  mordor_rate <span class="sc">-</span> non_mordor_rate</span>
<span id="cb16-11"><a href="#cb16-11" aria-hidden="true" tabindex="-1"></a>})</span>
